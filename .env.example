# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:password@localhost:5432/oakwood_db?schema=public"

# JWT_SECRET: Secret key for signing authentication JSON Web Tokens
JWT_SECRET="oakwood-residency-secure-jwt-secret-key-change-in-production"

# ADMIN_SETUP_SECRET: Protected secret key for initial bootstrap / programmatic admin creation
ADMIN_SETUP_SECRET="oakwood-admin-bootstrap-secret-change-in-production"

# RESEND_API_KEY: Resend API Key for sending transactional email notifications
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Sender email address or domain configured in Resend (e.g. 'Oakwood Residency <notifications@yourdomain.com>')
RESEND_FROM_EMAIL="Oakwood Residency <onboarding@resend.dev>"
